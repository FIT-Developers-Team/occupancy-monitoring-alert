# ============ WIOM / OAS — Environment ============
# Mode data: demo (pakai DB hasil seed) | live (tarik current-state dari Superset)
DATA_MODE=demo

# Path DuckDB (history ditulis oleh sync Python; app_state ditulis oleh web app)
DUCKDB_HISTORY_PATH=./db/warehouse_history.duckdb
DUCKDB_STATE_PATH=./db/app_state.duckdb

# Session (direkomendasikan di produksi — buat dengan: npm run secret:generate)
# Bila kosong, `npm start` membuat secret acak persisten di folder db secara
# otomatis. SESSION_SECRET/AUTH_SECRET tetap dianjurkan untuk multi-instance.
SESSION_SECRET=generate-with-npm-run-secret-generate

# Proteksi endpoint cron (/api/cron/*)
CRON_SECRET=change-me-cron-secret

# ---- Superset (opsional; konfigurasi utama ada di Pengaturan -> Superset Sync) ----
# Environment di bawah menimpa nilai UI dan cocok untuk secret manager/container.
SUPERSET_BASE_URL=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
SUPERSET_COOKIE_HEADER=
SUPERSET_SESSION_COOKIE=
SUPERSET_ACCESS_TOKEN=

# ---- Notifikasi (opsional) ----
# URL webhook Google Chat diisi lewat UI: Pengaturan -> Eskalasi (bukan env).
# APP_BASE_URL dipakai untuk tombol "Buka WIOM" pada kartu Google Chat.
APP_BASE_URL=http://localhost:3000

# ---- SMTP Email (opsional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WIOM Control Tower <wiom@astro.example>"
