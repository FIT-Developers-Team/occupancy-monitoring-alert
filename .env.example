# ============ FIT Occupancy Alert and Monitoring — Environment ============
# Mode data: demo (pakai DB hasil seed) | live (tarik current-state dari Superset)
DATA_MODE=demo

# Path DuckDB (history ditulis oleh sync Python; app_state ditulis oleh web app)
DUCKDB_HISTORY_PATH=./db/warehouse_history.duckdb
DUCKDB_STATE_PATH=./db/app_state.duckdb

# Session (direkomendasikan di produksi — buat dengan: npm run secret:generate)
# Bila kosong, `npm start` membuat secret acak persisten di folder db secara
# otomatis. SESSION_SECRET/AUTH_SECRET tetap dianjurkan untuk multi-instance.
SESSION_SECRET=generate-with-npm-run-secret-generate

# Proteksi endpoint cron (/api/cron/*). Boleh dikosongkan: `npm start` membuat
# dan menyimpan secret acak di db/.wiom-cron-secret sehingga evaluasi alert
# terjadwal langsung aktif tanpa langkah manual. Isi WIOM_SCHEDULER=0 bila
# penjadwalan dilakukan cron eksternal (deploy/crontab.example).
CRON_SECRET=change-me-cron-secret

# ---- Superset (opsional; konfigurasi utama ada di Pengaturan -> Superset Sync) ----
# Environment di bawah menimpa nilai UI dan cocok untuk secret manager/container.
# Opsi A: Pakai environment variables (dianjurkan untuk Coolify/deployment container)
SUPERSET_BASE_URL=https://dash.astronauts.id
SUPERSET_USERNAME=your_superset_username
SUPERSET_PASSWORD=your_superset_password
# Opsi B: Atau pakai cookie header (ambil dari browser DevTools → Network)
# SUPERSET_COOKIE_HEADER=
# SUPERSET_SESSION_COOKIE=
# SUPERSET_ACCESS_TOKEN=
# Image web tunggal menjalankan worker secara otomatis. Isi 0 hanya bila
# deployment memakai service `sync` terpisah seperti docker-compose.yml.
WIOM_EMBEDDED_SYNC=1
# Image Docker produksi memakai 1: worker dinyalakan dan ditunggu, tetapi
# kegagalannya dilaporkan (/api/ready, log start-up) — bukan mematikan server
# web yang sehat. Isi `strict` bila start-up memang harus gagal saat worker
# tidak siap.
WIOM_SYNC_REQUIRED=1
# Fallback admin: tombol "Mulai & sync" boleh memulai daemon bila deployment
# menjalankan `next start` langsung dan melewati supervisor `npm start`.
WIOM_API_SYNC_BOOTSTRAP=1
# Opsional bila executable Python bukan `python3`/`python`.
WIOM_SYNC_PYTHON=

# ---- Notifikasi (opsional) ----
# URL webhook, cakupan WH, dan auto-tag diisi lewat Pengaturan -> Eskalasi.
# APP_BASE_URL dipakai untuk tombol pembuka detail alert pada kartu Google Chat.
APP_BASE_URL=http://localhost:3000
# Opsional untuk preview dari browser QA terisolasi; pisahkan host dengan koma.
NEXT_ALLOWED_DEV_ORIGINS=
# Folder konfigurasi runtime. Seluruh penyimpanan dari halaman Pengaturan —
# ambang, kapasitas, gudang, eskalasi, Superset Sync, akun, dan kredensial —
# mendarat di sini, BUKAN di config/ yang ikut dibangun ke dalam image dan
# kembali ke nilai bawaan setiap kali image dibangun ulang. Kosong = 
# db/runtime-config, yaitu di dalam volume /app/db yang sudah permanen.
# Folder ini WAJIB dapat ditulis; /api/ready mengembalikan 503 bila tidak.
WIOM_RUNTIME_CONFIG_DIR=
# Jaring pengaman bila volume permanen benar-benar tidak dapat dipasang:
# tempel di sini nilai dari Pengaturan -> Cadangan konfigurasi -> "Salin nilai
# environment". Container baru memulihkan konfigurasi dari nilai ini saat
# berkas runtime-nya belum ada. Berkas runtime yang sudah ada selalu menang,
# jadi nilai ini tidak pernah menimpa penyetelan yang lebih baru. Isinya
# memuat kredensial — perlakukan sebagai secret.
WIOM_CONFIG_BUNDLE=

# ---- SMTP Email (opsional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FIT Occupancy Alert and Monitoring <occupancy-alert@astro.example>"

# ---- Koreksi jam sumber pergerakan ----
# Kolom created_at/updated_at pada movement_events datang dari WMS lewat
# Superset, dan nilainya SUDAH menerima satu konversi +07:00 di hulu: jam
# dinding WIB diperlakukan sebagai UTC lalu diubah ke Asia/Jakarta sekali lagi.
# Akibatnya jam yang tersimpan tujuh jam di depan kejadian sebenarnya — baris
# bertanda 14:30 benar-benar terjadi pukul 07.30 WIB (dicek ke WMS 2026-08-26).
#
# Nilai di bawah dikurangkan saat MENAMPILKAN saja; isi basis data tidak
# disentuh, karena created_at dipakai sebagai watermark sinkron ke Superset.
# Kolom milik proses sinkron (_synced_at, _sync_audit) tidak ikut digeser —
# jam itu memang sudah WIB yang benar.
#
# Setel 0 begitu hulunya diperbaiki, supaya perbaikan di sana tidak justru
# menciptakan selisih tujuh jam yang baru ke arah sebaliknya.
WIOM_SOURCE_CLOCK_SHIFT_HOURS=7
