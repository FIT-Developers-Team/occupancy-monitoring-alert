# /etc/systemd/system/wiom-daily-summary.service
[Unit]
Description=WIOM daily operational summary
After=wiom-web.service

[Service]
Type=oneshot
EnvironmentFile=/opt/wiom/.env
ExecStart=/usr/bin/curl -fsS -X POST -H "Authorization: Bearer ${CRON_SECRET}" http://127.0.0.1:3000/api/cron/daily-summary
User=wiom
