{
  "name": "wiom-oas",
  "version": "1.0.0",
  "private": true,
  "description": "WIOM/OAS — Warehouse Inventory Occupancy Monitoring & Alert Control Tower (FIT, Astro)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-next.mjs && next build --webpack",
    "start": "node scripts/start-production.mjs",
    "secret:generate": "node scripts/generate-secret.mjs",
    "seed": "node scripts/seed.mjs",
    "db:init": "node scripts/seed.mjs --schema-only",
    "hash-password": "node scripts/hash-password.mjs",
    "cron:tick": "curl -s -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3000/api/cron/tick"
  },
  "dependencies": {
    "next": "16.1.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "duckdb": "^1.3.2",
    "chart.js": "^4.4.7",
    "zod": "^3.24.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/nodemailer": "^6.4.17",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.4.49"
  }
}
