      "page": "/api/alerts/[id]/ack",
      "regex": "^/api/alerts/([^/]+?)/ack(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/alerts/(?<nxtPid>[^/]+?)/ack(?:/)?$"
    },
    {
      "page": "/api/alerts/[id]/false-positive",
